#!/usr/bin/env bash
set -euo pipefail
stamp=$(date -u +%Y%m%dT%H%M%SZ)
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CTF_HOME="${CTF_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
dest="$CTF_HOME/backups/$stamp"
mkdir -p "$dest"
cp "$CTF_HOME/config/tools.json" "$CTF_HOME/config/requirements-ctf.txt" "$CTF_HOME/config/requirements-ctf.lock" "$dest/" 2>/dev/null || true
cp "$CTF_HOME/config/activate-ctf.sh" "$CTF_HOME/bin/ctf-doctor" "$dest/"
[ -f "${HOME:-}/.gdbinit" ] && cp "$HOME/.gdbinit" "$dest/"
chmod 700 "$dest"
printf '%s\n' "$dest"
