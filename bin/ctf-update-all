#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${CTF_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
BIN="$ROOT/bin"
CFG="$ROOT/config"
SCRIPTS="$ROOT/scripts"
PY="${CTF_PYTHON:-python3}"
LOGDIR="$ROOT/logs/update"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/$STAMP.log"
exec > >(tee -a "$LOG") 2>&1

echo "=== CTF update started: $STAMP ==="
echo "Log: $LOG"

echo '[1/7] Backup current configuration'
"$BIN/backup-ctf-config"

echo '[2/7] Update Kali packages'
sudo apt update
sudo apt full-upgrade -y

echo '[3/7] Update Python CTF environment'
"$PY" -m pip install --upgrade pip
"$PY" -m pip install --upgrade -r "$CFG/requirements-ctf.in"
"$PY" -m pip freeze --local | sort > "$CFG/requirements-ctf.lock"

echo '[4/7] Update user Ruby CTF tools'
gem update --user-install

update_repo() {
  local repo="$1"
  if [ ! -d "$repo/.git" ]; then
    echo "SKIP missing repo: $repo"
  elif git -C "$repo" diff --quiet && git -C "$repo" diff --cached --quiet; then
    git -C "$repo" pull --ff-only
  else
    echo "SKIP dirty repo (local changes preserved): $repo"
  fi
}

echo '[5/7] Update source-built CTF tools'
update_repo /opt/ctf-tools/pwn/pwndbg
PYCDC_ROOT="${PYCDC_ROOT:-${HOME:-}/Tools/ctf-dev/pycdc}"
CTFD_PLAYER_ROOT="${CTFD_PLAYER_ROOT:-$ROOT/tools/ctfd-player-cli}"
update_repo "$PYCDC_ROOT"
update_repo "$CTFD_PLAYER_ROOT"
if [ -f "$CTFD_PLAYER_ROOT/pyproject.toml" ] || [ -f "$CTFD_PLAYER_ROOT/setup.py" ]; then
  "$PY" -m pip install --upgrade --editable "$CTFD_PLAYER_ROOT"
fi
if [ -d "$PYCDC_ROOT/.git" ]; then
  cmake -S "$PYCDC_ROOT" -B "$PYCDC_ROOT/build" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$PYCDC_ROOT/build" -j2
  mkdir -p "${PYCDC_BIN_DIR:-${HOME:-}/.local/bin}"
  ln -sfn "$PYCDC_ROOT/build/pycdc" "${PYCDC_BIN_DIR:-${HOME:-}/.local/bin}/pycdc"
fi

echo '[6/7] Refresh inventory and verify'
"$SCRIPTS/refresh-tools-json.py"
"$BIN/ctf-doctor"

echo '[7/7] Save post-update backup'
"$BIN/backup-ctf-config"
echo "=== CTF update completed: $(date -u +%Y%m%dT%H%M%SZ) ==="
